#!/usr/bin/env bash
# Optional pre-push hook: runs `npm run docs:check` when the pushed commits touch docs/,
# mkdocs.yml or src/. Turn it on with: git config core.hooksPath .githooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
touched=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # deleting a branch
  base="$remote_sha"
  # New branch, or a remote commit we do not have: compare against the merge base with main.
  if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha^")"
  fi
  if git diff --name-only "$base..$local_sha" | grep -E '^(docs/|mkdocs\.yml$|src/)' >/dev/null; then
    touched=1
  fi
done
[ "$touched" = 1 ] || exit 0
echo "pre-push: docs, mkdocs.yml or src/ changed; running npm run docs:check"
npm run docs:check
